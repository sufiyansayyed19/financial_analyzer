# FinRAG Environment Configuration
# Copy this to .env and fill in your values

# Application
DEBUG=true
LOG_LEVEL=INFO

# Paths (optional — defaults work for local development)
# DATA_DIR=d:\New folder\nlp_project\data
# PROCESSED_DIR=d:\New folder\nlp_project\processed

# Embeddings (Phase 2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database (Phase 2)
# SQLite (default — zero setup):
DATABASE_URL=sqlite:///finrag.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://user:pass@localhost:5432/finrag

# LLM (Phase 3)
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyD16Y75gpA3eVLXYDpHhdTLEIgzhL2CCFo
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
